@article{SSOG,
  abbr = {Georgia Tech},
  title={A Multi-Scale Path Planning Optimization for Planetary Rovers in Uncertain Terrain},
  author = {Rohan Devraj, Nicholas Gollins, Masafumi Isaji, Koki Ho},
  note = {Rohan Devraj, Prof. Koki Ho, Dr. Masafumi Isaji, Dr. Nicholas Gollins},
  subtitle = {Accepted to AIAA ASCEND 2026 | Space Systems Optimization Group},
  Month={May},
  year={2026},
  publisher={GT},
  preview={ssog.jpg},
  abstract = {As part of the Space Systems Optimization Group at Georgia Tech, I conducted research on optimizing planetary rover surface routing to enable energy-efficient and autonomous exploration under uncertain terrain conditions. This work develops a multi-scale optimization framework for planning rover trajectories over large, partially observed terrain maps derived from orbital satellite data. 
  At the global planning level, I formulate a Mixed-Integer Linear Programming (MILP) model that determines optimal visitation sequences across thousands of candidate surface locations. The MILP incorporates elevation-based terrain costs to capture gravitational energy expenditure and enforces routing feasibility through modified Miller–Tucker–Zemlin subtour elimination constraints, ensuring valid non-cyclic mission paths. Pairwise travel costs between locations are computed using A* search over a coarse elevation grid, allowing the MILP to operate over physically meaningful traversal costs without explicitly modeling fine-resolution terrain at the optimization level. 
  To bridge global planning and local execution, I develop a three-layer hierarchical architecture. 
  The first layer uses A* search for pairwise routing on a coarse grid, the second layer solves the global MILP for optimal visitation sequencing, and the third layer performs stochastic local replanning using a Markov Decision Process (MDP) on an adaptively refined grid. 
  This local layer accounts for uncertainty in satellite-derived elevation data through interpolation-based terrain refinement and stochastic cost modeling, enabling obstacle avoidance and dynamic adaptation to newly observed terrain features during execution. 
  Together, this hierarchical framework combines graph-based routing, global combinatorial optimization, and uncertainty-aware local decision-making to enable scalable and robust planetary navigation. 
  The overarching goal of this research is to improve mission resilience, energy efficiency, and autonomy for long-duration robotic exploration in uncertain and data-limited environments. 
  This work was presented at AIAA ASCEND 2026 as a first-author paper.},
  code = https://github.com/rdevraj3105/stochastic-vehicle-routing,
  doi = {10.2514/6.2026-3018},
  url = {https://arc.aiaa.org/doi/10.2514/6.2026-3018},
  selected = {true},
  pdf = ASCEND_RohanDevraj.pdf,
  appear = {true}
}

